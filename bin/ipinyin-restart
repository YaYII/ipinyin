#!/bin/sh
# 安全重启输入法：先杀干净所有引擎进程，等它们真的退出，再让 IBus 重新拉起。
# 直接 kill + 立刻重启会出现「两个引擎抢同一个名字」，IBus 把按键送进半死的那个。
set -u

# 用 ^ 锚定真实进程，避免把「命令行里提到这个字符串」的 shell 也匹配上
PATTERN="^/usr/bin/python3 .*/ipinyin-engine --ibus"

pids=$(pgrep -f "$PATTERN" 2>/dev/null || true)
[ -n "$pids" ] && echo "停止旧引擎：$pids"
for pid in $pids; do
    kill "$pid" 2>/dev/null || true
done

# 最多等 5 秒让它们体面退出
i=0
while [ $i -lt 20 ]; do
    remaining=$(pgrep -f "$PATTERN" 2>/dev/null || true)
    [ -z "$remaining" ] && break
    sleep 0.25
    i=$((i + 1))
done

remaining=$(pgrep -f "$PATTERN" 2>/dev/null || true)
if [ -n "$remaining" ]; then
    echo "仍有残留，强制结束：$remaining"
    for pid in $remaining; do
        kill -9 "$pid" 2>/dev/null || true
    done
    sleep 0.5
fi

echo "重启 IBus…"
ibus restart >/dev/null 2>&1 || true
sleep 2
ibus engine ipinyin >/dev/null 2>&1 || true
sleep 3

count=$(pgrep -f "$PATTERN" 2>/dev/null | wc -l)
echo "引擎进程数：$count"
if [ "$count" -eq 0 ]; then
    echo "引擎没起来——请按 Super+空格 切换一次输入源触发启动"
elif [ "$count" -gt 1 ]; then
    echo "警告：仍有多个引擎（单实例锁应阻止这种情况），请报告"
else
    echo "正常：单引擎已注册"
fi
