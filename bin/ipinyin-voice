#!/usr/bin/env python3
"""命令行测试语音识别：ipinyin-voice [--seconds N] [--file WAV] [--lang yue|zh|auto]

不给 --file 就现场录音 N 秒（默认 3 秒），识别结果打印到 stdout。
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))
sys.path.insert(0, "/usr/lib/ipinyin")

from ipinyin import asr  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description="测试 SenseVoice 语音识别")
    ap.add_argument("--seconds", type=float, default=3.0, help="录音秒数（默认 3）")
    ap.add_argument("--file", default=None, help="识别已有 wav，不录音")
    ap.add_argument("--lang", default="yue", choices=asr.LANGUAGES, help="语言（默认粤语）")
    args = ap.parse_args()

    rec = asr.Recognizer(language=args.lang)
    if not rec.available():
        print(f"模型未就绪：{asr.model_dir() or '（没找到）'}", file=sys.stderr)
        print("下载：https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/"
              f"{asr.MODEL_NAME}.tar.bz2", file=sys.stderr)
        return 2

    path = args.file or asr.record(args.seconds)
    if not args.file:
        print(f"录好 {args.seconds:.0f}s：{path}", file=sys.stderr)
    text = rec.recognize_file(path)
    print(text)
    return 0 if text else 1


if __name__ == "__main__":
    raise SystemExit(main())
