#!/usr/bin/env python3
"""屏幕感知 CLI：把截图变成上下文。

用法：
    ipinyin-vision status          看监看哪些目录、有没有配模型命令
    ipinyin-vision scan            只列出新截图，不调用模型
    ipinyin-vision once            扫一次：新截图 → 调模型 → 落 vision.jsonl
    ipinyin-vision watch           常驻：每 20 秒扫一次（Ctrl+C 退出）
    ipinyin-vision recent [N]      看最近 N 条上下文

模型命令用环境变量配置（{image} / {prompt} 会被替换）：
    export IPINYIN_VISION_CMD='opencode run --model deepseek-v4.1-flash -f {image} "{prompt}"'
"""
import os
import sys
import time

_HERE = os.path.dirname(os.path.realpath(__file__))
for _candidate in (
    os.path.join(_HERE, "..", "lib"),
    os.path.join(_HERE, "..", "src"),
    os.path.expanduser("~/.local/share/ipinyin/lib"),
    "/usr/lib/ipinyin",
):
    if os.path.isdir(os.path.join(_candidate, "ipinyin")):
        sys.path.insert(0, os.path.abspath(_candidate))
        break

from ipinyin import vision  # noqa: E402


def main(argv: list[str]) -> int:
    command = argv[1] if len(argv) > 1 else "status"
    if command == "status":
        info = vision.status()
        print(f"监看目录：{len(info['dirs'])} 个")
        for directory in info["dirs"]:
            print(f"  - {directory}")
        print(f"模型命令：{'已配置' if info['cmd'] else '未配置（只记录截图路径）'}")
        print(f"已记录上下文：{info['entries']} 条")
        print(f"数据目录：{info['home']}")
        return 0
    if command == "scan":
        paths = vision.scan()
        print(f"新截图 {len(paths)} 张")
        for path in paths[:10]:
            print(f"  {path}")
        return 0
    if command == "once":
        rows = vision.capture_context()
        print(f"处理 {len(rows)} 张")
        for row in rows:
            print(f"  {os.path.basename(row['image'])}: {row['desc'] or '（未调用模型）'}")
        return 0
    if command == "watch":
        interval = int(os.environ.get("IPINYIN_VISION_INTERVAL", "20"))
        print(f"每 {interval} 秒扫一次，Ctrl+C 退出")
        try:
            while True:
                vision.capture_context()
                time.sleep(interval)
        except KeyboardInterrupt:
            return 0
    if command == "recent":
        limit = int(argv[2]) if len(argv) > 2 else 10
        for row in vision.recent(limit):
            print(f"{row['ts']}  {os.path.basename(row.get('image', ''))}")
            if row.get("desc"):
                print(f"    {row['desc']}")
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
