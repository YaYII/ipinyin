#!/usr/bin/env python3
"""启动 IBus 拼音引擎。开发时从仓库运行，安装后从 ~/.local/share/ipinyin 运行。"""
import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
for _candidate in (
    os.path.join(_HERE, "..", "lib"),   # 安装后的布局
    os.path.join(_HERE, "..", "src"),   # 仓库里的布局
):
    if os.path.isdir(os.path.join(_candidate, "ipinyin")):
        sys.path.insert(0, os.path.abspath(_candidate))
        break

from ipinyin.engine import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
