#!/usr/bin/env python3
"""引擎重启后的收尾：ibus-daemon 在引擎被杀时会把"当前引擎"清空，
这里发现位子空着就补回 ipinyin；用户选了别的输入法（位子有人）就绝不动手。
"""
import subprocess
import sys
import time


def main() -> int:
    for _ in range(12):  # 最多等 6 秒，等引擎把总线名注册上
        time.sleep(0.5)
        probe = subprocess.run(["ibus", "engine"], capture_output=True, text=True)
        if probe.returncode == 0 and probe.stdout.strip():
            return 0  # 已经有引擎在岗，不抢
        subprocess.run(["ibus", "engine", "ipinyin"], capture_output=True)
        check = subprocess.run(["ibus", "engine"], capture_output=True, text=True)
        if check.returncode == 0 and check.stdout.strip():
            print(f"已恢复当前引擎：{check.stdout.strip()}", flush=True)
            return 0
    print("恢复当前引擎失败（可能需要重新选择输入源）", file=sys.stderr, flush=True)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
